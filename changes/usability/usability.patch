+import type { ScanPlanTask } from "./tools/scan-plan"
+
+/** A read model of the recorded plan; no lifecycle or task state is changed here. */
+export function scanProgress(tasks: readonly ScanPlanTask[]) {
+  const done = new Set(tasks.filter((task) => task.status === "done").map((task) => task.task_id))
+  const items = tasks.map((task) => {
+    const waiting = task.depends_on.filter((id) => !done.has(id))
+    const status =
+      (task.status === "pending" || task.status === "in_progress") && waiting.length
+        ? "blocked"
+        : task.status === "done"
+          ? "completed"
+          : task.status === "in_progress"
+            ? "running"
+            : task.status
+    const reason = [task.result, waiting.length ? `Waiting for ${waiting.join(", ")}` : undefined].filter(Boolean).join(" · ")
+    return {
+      id: task.task_id,
+      title: task.title,
+      status,
+      ...(reason ? { reason } : {}),
+    }
+  })
+  return {
+    completed: items.filter((task) => task.status === "completed").length,
+    running: items.filter((task) => task.status === "running").length,
+    pending: items.filter((task) => task.status === "pending").length,
+    blocked: items.filter((task) => task.status === "blocked").length,
+    cancelled: items.filter((task) => task.status === "cancelled").length,
+    tasks: items,
+  }
+}
