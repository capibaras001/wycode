+import { createEffect, createMemo, For, Show } from "solid-js"
+import { Option } from "effect"
+import { useData } from "../../context/data"
+import { useTheme } from "../../context/theme"
+import { assessmentProgress, assessmentState } from "../../util/assessment"
+
+export function AssessmentProgress(props: { sessionID: string }) {
+  const data = useData()
+  const theme = useTheme()
+  const state = createMemo(() => Option.getOrUndefined(assessmentState(data.session.get(props.sessionID)?.metadata?.["wycode.scan"])))
+  const family = createMemo(() => [props.sessionID, ...data.session.family(props.sessionID).filter((id) => id !== props.sessionID)])
+  // Load only this assessment family; existing message events keep these views current.
+  createEffect(() => {
+    const current = state()
+    if (!current) return
+    for (const id of family()) {
+      if (id === props.sessionID || data.session.get(id)?.metadata?.["wycode.scan"] === undefined) continue
+      void data.session.message.sync(id).catch(() => {})
+    }
+  })
+  const messages = createMemo(() => family().flatMap((id) => {
+    const entries = data.session.message.list(id)
+    if (id !== props.sessionID) return Option.getOrUndefined(assessmentState(data.session.get(id)?.metadata?.["wycode.scan"]))?.scanID === state()?.scanID ? entries : []
+    const boundary = entries.findIndex((message) => message.id === state()?.inputID)
+    return boundary < 0 ? entries : entries.slice(boundary + 1)
+  }))
+  const progress = createMemo(() => messages().flatMap((message) => message.type !== "assistant" ? [] : message.content.flatMap((part) => {
+    if (part.type !== "tool" || part.state.status !== "completed") return []
+    const summary = Option.getOrUndefined(assessmentProgress(part.state.metadata?.["wycode.progress"]))
+    const order = part.state.metadata?.["wycode.bookkeeping"]
+    return summary?.scanID === state()?.scanID && typeof order === "number" ? [{ summary, order }] : []
+  })).sort((a, b) => b.order - a.order)[0]?.summary)
+  const restoring = new Set<string>()
+  const hasSnapshot = (id: string, scanID: string) => data.session.message.list(id).some((message) =>
+    message.type === "assistant" && message.content.some((part) => part.type === "tool" && part.state.status === "completed" &&
+      Option.getOrUndefined(assessmentProgress(part.state.metadata?.["wycode.progress"]))?.scanID === scanID))
+  createEffect(() => {
+    const current = state()
+    if (!current) return
+    for (const id of family()) {
+      const entries = data.session.message.list(id)
+      if (hasSnapshot(id, current.scanID) || !data.session.message.more(id) ||
+        (id === props.sessionID && entries.some((message) => message.id === current.inputID)) || restoring.has(id)) continue
+      restoring.add(id)
+      void (async () => {
+        while (state()?.scanID === current.scanID && !hasSnapshot(id, current.scanID) && data.session.message.more(id)) {
+          if (id === props.sessionID && data.session.message.list(id).some((message) => message.id === current.inputID)) break
+          await data.session.message.loadMore(id)
+        }
+      })().catch(() => {}).finally(() => restoring.delete(id))
+    }
+  })
+  const retry = createMemo(() => {
+    if (state()?.status !== "running") return
+    return family().flatMap((id) => {
+      const latest = messages().filter((message) => data.session.message.get(id, message.id) !== undefined && message.type === "assistant").at(-1)
+      return latest?.type === "assistant" && latest.retry ? [latest.retry] : []
+    }).sort((a, b) => b.at - a.at)[0]
+  })
+  return (
+    <Show when={state()}>{(current) => (
+      <box flexDirection="column" flexShrink={0} paddingLeft={1} paddingRight={1}>
+        <text fg={theme.text.base} wrapMode="word">Assessment {current().status} · {current().target}</text>
+        <Show when={progress()} fallback={<text fg={theme.text.muted}>Waiting for a recorded scan plan</text>}>{(summary) => (
+          <>
+            <text fg={theme.text.muted} wrapMode="word">
+              {current().status !== "running" ? "Last recorded: " : ""}{summary().completed} completed · {summary().running} running · {summary().pending} pending · {summary().blocked} blocked · {summary().cancelled} cancelled
+            </text>
+            <For each={summary().tasks.filter((task) => task.status === "running" || task.status === "blocked").slice(0, 2)}>{(task) => (
+              <text fg={task.status === "blocked" ? theme.text.feedback.warning.base : theme.text.muted} wrapMode="word">
+                {task.status}: {task.title}{task.reason ? ` — ${task.reason}` : ""}
+              </text>
+            )}</For>
+          </>
+        )}</Show>
+        <Show when={retry()}>{(value) => <text fg={theme.text.feedback.warning.base} wrapMode="word">Retry attempt {value().attempt}: {value().error.message}</text>}</Show>
+        <Show when={current().error}>{(error) => <text fg={theme.text.feedback.warning.base} wrapMode="word">{error()}</text>}</Show>
+      </box>
+    )}</Show>
+  )
+}
